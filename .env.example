# ==========================================
# Kitchora Global Environment Configuration
# ==========================================

# BACKEND CONFIGURATION
DATABASE_URL=sqlite:///./kitchora.db
# For PostgreSQL (Neon/Supabase/Railway/Local):
# DATABASE_URL=postgresql://user:password@localhost:5432/kitchora_db

JWT_SECRET=super_secret_jwt_key_kitchora_production_change_me_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

REDIS_URL=redis://localhost:6379/0
# Optional Upstash Redis:
# REDIS_URL=rediss://default:password@your-upstash-instance.upstash.io:6379

AI_API_KEY=your_gemini_or_openai_api_key_here
AI_PROVIDER=gemini  # gemini | openai | fallback

FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
PORT=8000

# FRONTEND CONFIGURATION
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_APP_NAME=Kitchora
